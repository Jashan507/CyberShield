# ============================================================
# CyberShield Server Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to GitHub!
# Copy this file to .env and fill in your actual values.

# Server port (default: 5000)
PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Replace <username>, <password>, and <dbname> with your actual values
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/cybershield?retryWrites=true&w=majority

# JWT Configuration
# Use a long random string (min 32 characters) for JWT_SECRET
# Generate one at: https://generate-random.org/api-key-generator
JWT_SECRET=change_this_to_a_very_long_random_secret_string_at_least_32_chars
JWT_EXPIRE=7d

# Environment (development | production)
NODE_ENV=development

# Frontend URL (for CORS)
# Development:
CLIENT_URL=http://localhost:5173
# Production (Vercel/Netlify URL):
# CLIENT_URL=https://cybershield.vercel.app

# Initial admin credentials (used only by seed script)
ADMIN_EMAIL=admin@cybershield.com
ADMIN_PASSWORD=Admin@123456
